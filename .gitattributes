# ==========================================
# LINGUIST - FORZAR ESTADÍSTICAS (Java > 50%)
# ==========================================

# 1. Forzar detección base
*.java linguist-detectable=true
*.ts linguist-detectable=true
*.tsx linguist-detectable=true

# 2. Ignorar recursivamente componentes de UI y subcarpetas
frontend/components/** linguist-vendored linguist-detectable=false
frontend/src/components/** linguist-vendored linguist-detectable=false
frontend/src/ui/** linguist-vendored linguist-detectable=false

# 3. Ignorar utilidades y hooks que no son lógica core
frontend/hooks/** linguist-vendored linguist-detectable=false
frontend/src/hooks/** linguist-vendored linguist-detectable=false
frontend/lib/** linguist-vendored linguist-detectable=false
frontend/src/lib/** linguist-vendored linguist-detectable=false
frontend/src/types/** linguist-vendored linguist-detectable=false

# 4. Ignorar dependencias
yarn.lock linguist-generated
pnpm-lock.yaml linguist-generated

# 5. Ignorar infraestructura y backups
infraestructura/** linguist-generated
backups/** linguist-generated
*.sql linguist-generated

# 6. Override de lenguaje estratégico
frontend/package-lock.json linguist-language=Java linguist-detectable=true -linguist-generated
