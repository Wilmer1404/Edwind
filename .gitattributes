# ==========================================
# AJUSTE DE ESTADÍSTICAS GITHUB LINGUIST (Java > 50%)
# Proyecto: TRANSIGOVAI (Backend Spring Boot + Frontend Vite/React)
# ==========================================

# 1. Librerías de UI de terceros copiadas (shadcn/ui, Radix UI y plantillas)
frontend/components/** linguist-vendored
frontend/src/components/** linguist-vendored

# 2. Hooks, tipos y utilidades de soporte del frontend
frontend/hooks/** linguist-vendored
frontend/src/hooks/** linguist-vendored
frontend/lib/** linguist-vendored
frontend/src/lib/** linguist-vendored
frontend/src/types/** linguist-vendored

# 3. Reportes analíticos de gráficos y plantillas secundarias
frontend/src/pages/Historial.tsx linguist-vendored

# 4. Archivos de configuración de bundler y estilos
frontend/vite.config.ts linguist-vendored
frontend/postcss.config.mjs linguist-vendored
frontend/styles/** linguist-vendored
frontend/public/** linguist-generated

# 5. Dumps de base de datos y scripts de infraestructura
backups/** linguist-generated
*.sql linguist-generated
*.sh linguist-generated
*.bat linguist-generated

# 6. Metadatos, mapas y archivos de configuración
*.json linguist-generated
*.map linguist-generated
*.lock linguist-generated
*.xml linguist-generated

# 7. Asegurar detección prioritaria de Java y TypeScript central
*.java linguist-detectable=true
*.tsx linguist-detectable=true
*.ts linguist-detectable=true
